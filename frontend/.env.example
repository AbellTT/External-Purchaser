# Geoapify API key — get yours at https://www.geoapify.com/
VITE_GEOAPIFY_API_KEY=your_api_key_here

# API Configuration (backend base URL, no trailing slash)
# Local dev example: http://localhost:8001/api
VITE_API_BASE_URL=http://localhost:3000/api

# WebSocket Configuration (secure backend origin, no path)
# Production example: wss://external-purchaser-production.up.railway.app
# Leave unset for local dev to use the legacy ws://localhost:8002 server
VITE_WS_BASE_URL=

# Environment
VITE_ENV=development
