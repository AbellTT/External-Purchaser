# Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=babi_procurement
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
# Set to true for managed Postgres with SSL (e.g. Supabase)
DB_SSL_REQUIRE=false

# Supabase Configuration (for production)
# SUPABASE_URL=your_supabase_url
# SUPABASE_KEY=your_supabase_key
# SUPABASE_DB_HOST=your_supabase_db_host
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_PASSWORD=your_supabase_password
# SUPABASE_DB_PORT=5432

# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Security — set COOKIE_SECURE=true in production (HTTPS).
# Requires cross-site refresh cookies (Vercel frontend -> Railway backend) to work.
COOKIE_SECURE=false

# CORS Settings (comma-separated; localhost dev origins are always included while DEBUG=true)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CSRF trusted origins (scheme + host), required for production frontend origin:
CSRF_TRUSTED_ORIGINS=

# JWT Settings
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7
